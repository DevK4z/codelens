{
  "name": "codelens-backend",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "node --import tsx src/test_samples.ts && node --import tsx test_errors.ts && npm run test:regression",
    "test:regression": "node --import tsx regression.test.ts",
    "traces": "node --import tsx export_demo_traces.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/uuid": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
