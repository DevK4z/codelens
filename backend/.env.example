# docker: compile and run every submission inside a fresh codelens-sandbox container (VPS).
# sandbox: jailed processes inside the service container; set by backend/Dockerfile for Render.
# Required whenever the backend is reachable through a tunnel or reverse proxy;
# LocalRunner refuses proxied requests because it has no isolation.
RUNNER=docker

# Browser origins allowed to call the API (scheme + host, no path).
CORS_ORIGINS=http://localhost:5173,https://devk4z.github.io

# Abuse limits for POST /api/v1/runs (shared with the deprecated /api/execute).
RATE_LIMIT_PER_MIN=20
MAX_CONCURRENT_RUNS=2
MAX_QUEUED_RUNS=8

# sandbox runner only: per-program run limit (max 20000; Render free needs 20000) and memory.
RUN_TIMEOUT_MS=5000
SANDBOX_MEMORY_MB=512
